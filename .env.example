# Copy this file to .env and fill local-only values.
# Do not commit real credentials, API keys, or internal hostnames.

DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

POSTGRES_DB=human-resource
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>

VITE_API_BASE=
# (구 VITE_GEMINI_API_KEY / VITE_OPENAI_API_KEY 제거 — AI는 서버 프록시 /api/ai/chat 전용이라
#  브라우저는 LLM 키를 갖지 않는다. VITE_ 접두 키는 번들에 노출되므로 추가 금지.)

# HR 설정의 위험 영역(DB 일괄삭제) 노출 여부. 운영 기본은 꺼짐.
# 로컬에서 사용할 때만 'true' 로 설정. (그 외 빈값/false/0 등은 모두 숨김)
VITE_ENABLE_DANGER_ZONE=false

# ── AI 연동 (서버 프록시 /api/ai/chat 전용 — 브라우저는 LLM을 직접 호출하지 않음) ──
# [임시·내부망 이식 전] GitHub Models(외부 API): AI_API_KEY 만 채우면 됨
#   (기본 AI_BASE_URL=https://models.github.ai/inference, 기본 AI_MODEL=openai/gpt-4.1-mini)
#   ⚠ 외부 API로 전송됨 — 실제 평가의견 검수에 사용하지 말고 테스트/샘플 데이터로만 사용 권장
# [내부망 이식 후] GPT-OSS 복귀: 아래 두 줄만 설정 (AI_API_KEY 불필요)
#   AI_BASE_URL=http://172.17.170.201:8000/v1
#   AI_MODEL=gpt-oss-120b
# 실제 값은 .env 에만 입력 (이 파일은 git에 커밋되므로 키 금지). 값의 따옴표는 있어도 되고 없어도 됨.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── 서버 보안/운영 ──
# 세션 쿠키에 Secure 속성 부여 — 리버스 프록시 TLS(HTTPS) 종단 뒤에서 'true'.
COOKIE_SECURE=false
# CORS 허용 오리진(콤마 구분). 비우면 로컬 dev 기본(5173/4173). 프록시·동일 호스트 요청은 항상 허용.
CORS_ORIGINS=
# DB 연결 실패 시 mock으로 기동 허용(개발 전용). 운영 기본은 fail-fast(미설정/false = 즉시 종료).
ALLOW_MOCK_FALLBACK=false
