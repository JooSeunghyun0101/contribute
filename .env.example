# Copy this file to .env and fill local-only values.
# Do not commit real credentials, API keys, or internal hostnames.

DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

POSTGRES_DB=human-resource
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>

VITE_API_BASE=
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
